.venv/
__pycache__/
*.pyc
.pytest_cache/

web/node_modules/
web/dist/
*.tsbuildinfo

# macOS/Finder 가 만든 중복 사본 ("generator 2.py" 같은 것)
* 2.*

# 생성 산출물 — 운영에서는 CI가 매 배포마다 다시 만든다.
# 문서를 리뷰 대상으로 삼고 싶으면 아래 두 줄을 주석 처리하고 커밋한다.
docs/*.md
docs/index.json

# 뷰어에서 불러온 로컬 프로젝트들 (사용자 머신마다 다름)
projects/

# 규제 지식그래프의 승인 저널·변경 제안·원문.
# 재생성 가능한 산출물이 아니라 감사 추적이라, 운영에서는 이 디렉터리를
# 백업 대상으로 두고 저장소에는 넣지 않는다 (`llmwiki reg seed` 로 데모 재생성).
# 앞의 / 가 없으면 소스인 llmwiki/compliance/ 까지 같이 무시된다.
/compliance/

# 컨설팅 원본 자료(고객사 규정·산출물 docx/xlsx/pptx). 이 저장소는 공개이므로
# 고객사 문서를 넣지 않는다. 작업에는 쓰되 이력에는 남기지 않는다.
/planning/

# 에너지 진단 위키 — 고객사 진단 보고서에서 만든 페이지와 검증 저널이다.
# 재생성 가능한 산출물처럼 보이지만 아니다: 검토자의 서명(review.jsonl)과 상태가
# 여기 붙어 있어서, 지우면 누가 무엇을 확정했는지가 사라진다.
# 앞의 / 가 없으면 소스인 llmwiki/ediag/ 하위 경로까지 함께 무시될 수 있다.
/wiki/

# 문서 지식베이스 적재본 — 고객사 문서에서 뽑은 채널·그래프와 적재 이력이다.
# 규제 게이트를 통과한 것만 들어가지만, 그래도 저장소에 넣을 것은 아니다.
# 앞의 / 가 없으면 소스인 llmwiki/kb/ 까지 같이 무시된다.
/knowledge/

.DS_Store
