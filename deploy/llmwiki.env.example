# LLMWiki 서비스 환경변수 — systemd EnvironmentFile
#
# 배치 위치: /etc/llmwiki/llmwiki.env
#   sudo install -o root -g llmwiki -m 640 llmwiki.env /etc/llmwiki/llmwiki.env
#
# 유닛 파일은 world-readable 이므로 키를 거기 적지 말고 반드시 이 파일에 둔다.
# 이 예시 파일에는 실제 키를 절대 채워 넣지 말 것 (저장소에 커밋된다).

# xAI Grok — provider: grok 일 때 필요
XAI_API_KEY=xai-...
XAI_MODEL=grok-4.20-0309-non-reasoning

# Claude — provider: claude 일 때 필요
#ANTHROPIC_API_KEY=sk-ant-...

# 사내 Ollama(provider: ollama)는 키가 필요 없다.
# 접속 주소·모델은 config.yaml 의 llm.ollama 에서 정한다.
